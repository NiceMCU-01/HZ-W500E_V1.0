# 测试环境变量示例
#
# 复制为 .env 并按实际情况填写；.env 已被 .gitignore 排除，不会提交。
# Windows PowerShell 也可以直接设到当前会话：
#   $env:WT32_COM_PORT  = "COM3"
#   $env:WT32_WIFI_SSID = "你的SSID"
#   $env:WT32_WIFI_PWD  = "你的密码"

# 串口号（CH340 等 USB 转串口设备）
WT32_COM_PORT=COM3

# 测试用 WiFi 凭据 —— 请勿把真实值写进任何提交到仓库的文件
WT32_WIFI_SSID=
WT32_WIFI_PWD=

# 测试服务端（脚本在本机监听的 TCP/UDP/HTTP）的可达 IP；
# 留空则由run_at_tests.py 自动探测本机局域网地址
WT32_HOST_IP=